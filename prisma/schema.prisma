// Printoo24 ERP — Prisma schema
// SQLite datasource

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─── Users / Auth ───────────────────────────────────────────────
// Phase 12 — RBAC چند-ماژوله:
//   role: "master" = ادمین سراسری (دسترسی ضمنی به همه‌چیز + تنظیمات سیستم).
//   برای بقیهٔ کاربران «منبع حقیقتِ دسترسی» = ردیف‌های UserModule است
//   (هر کاربر می‌تواند چند ماژول داشته باشد: مثلاً QC + چاپ).
//   role برای کاربران غیر-master فقط «ماژول اول» را آینه می‌کند (compat نمایش).
//   lastSeenAt/lastLoginAt/loginCount + UserActivityLog = حضور و غیابِ واقعی
//   (جایگزین سیستم حضورغیاب) — آنلاین = lastSeenAt جدیدتر از ۳ دقیقه.
model User {
  id             String   @id @default(cuid())
  name           String
  email          String   @unique
  password       String
  role           String   @default("operator") // master | (ماژول اول برای نمایش)
  phone          String?
  avatar         String?
  status         String   @default("active") // active | inactive
  lastSeenAt     DateTime?
  lastLoginAt    DateTime?
  loginCount     Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  assignedTasks  Task[]   @relation("TaskAssignee")
  modules        UserModule[]
  activityLogs   UserActivityLog[]
  // Phase 12: تخصیص/تکمیل — SetNull تا حذف کاربر، تاریخچه را نبکشد
  designAssignments     Order[]     @relation("OrderDesigner")
  printAssignments      Order[]     @relation("OrderPrinter")
  createdOrders         Order[]     @relation("OrderCreator")
  designCompletedItems  OrderItem[] @relation("ItemDesignCompleter")
  printCompletedItems   OrderItem[] @relation("ItemPrintCompleter")
  // Phase 13: تخصیص per-item (هر آیتم مجری خودش را دارد)
  designItemAssignments OrderItem[] @relation("ItemDesignAssignee")
  printItemAssignments  OrderItem[] @relation("ItemPrintAssignee")
  qcReported            QcReport[]  @relation("QcReporter")
  qcReviewed            QcReport[]  @relation("QcReviewer")
  // Phase 13: مرخصی‌ها (جایگزین حضورغیاب برای برنامهٔ حقوق/ارزیابی)
  leaves                UserLeave[]
  leavesGranted         UserLeave[] @relation("LeaveCreator")
  // Phase 14: رویدادهای سفارش که این کاربر انجام داده (تاریخچه)
  orderEvents           OrderEvent[] @relation("OrderEventActor")
  // Phase 17: وضعیت خواندن اعلان‌ها (هر-کاربر)
  notificationReads     NotificationRead[]
  // ─── Phase 15: مالی ──
  createdCosts          MaterialCost[] @relation("CostCreator")
  revenueLogs           RevenueLog[]  @relation("RevenueCreator")
  // ─── Phase 16: حقوق و دستمزد ──
  baseSalary            Float?      // قرارداد حقوق پایه ماهانه (دینار)
  payrollEntries        PayrollEntry[]
  payrollAdvances       PayrollAdvance[] @relation("AdvanceReceiver")
  payrollAdvancesGiven  PayrollAdvance[] @relation("AdvanceCreator")
  paidPayrollPeriods    PayrollPeriod[] @relation("PayrollPeriodPayer")
  // ─── Phase 16: انبار/لجستیک ──
  packagesCreated       Package[]   @relation("PackageCreator")
}

// ─── Phase 13: مرخصی (leave) ────────────────────────────────────
// ادمین از پروفایل کاربر بازهٔ مرخصی ثبت می‌کند (yyyy-MM-dd لوکال —
// مثل DayNote بدون تایم‌زون). برای «امروز فلان طراح نیست» و گزارش
// حقوق/ارزیابی آینده. حذف کاربر → Cascade (مرخصی بی‌صاحب بی‌معناست).
model UserLeave {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  startDate   String   // "yyyy-MM-dd" local day key
  endDate     String   // "yyyy-MM-dd" local day key (شامل خود روز)
  note        String?
  createdById String?
  createdByUser User?  @relation("LeaveCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())

  @@index([userId, startDate])
}

// ─── Phase 12: دسترسی کاربر به ماژول‌ها (many-to-many) ───────────
// module ∈ admin | designer | print | warehouse | finance | qc | crm | srm
// (هم‌ارز ModuleKey در lib/constants.ts). master ردیف نیاز ندارد — همه‌چیز را
// می‌بیند. sidebar، پالت فرمان و همهٔ گاردهای API از همین جدول تغذیه می‌شوند.
model UserModule {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  module    String
  createdAt DateTime @default(now())

  @@unique([userId, module])
  @@index([module])
}

// ─── Phase 12: لاگ ورود/خروج — غذای «مدیریت کارمندان» ────────────
// action ∈ login | logout. روزانه: اولین/آخرین اکشن + تعداد ورود.
model UserActivityLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  action    String   // login | logout
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

// ─── CRM: Customers ─────────────────────────────────────────────
model Customer {
  id          String       @id @default(cuid())
  name        String
  phone       String
  address     String?      // Phase 16: آدرس مشتری (پیش‌فرض ارسال)
  city        String?      // شهر (استان/شهر جدا برای فیلتر و ارسال)
  province    String?      // استان
  isFavorite  Boolean      @default(false)
  balanceDue  Float        @default(0)
  note        String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  orders      Order[]
  preInvoices PreInvoice[]
  invoices    Invoice[]
  payments    Payment[]
  deals       Deal[]
  activities  Activity[]
}

// ─── SRM: Suppliers ─────────────────────────────────────────────
model Supplier {
  id            String   @id @default(cuid())
  name          String
  phone         String?
  contactPerson String?
  address       String?
  balanceDue    Float    @default(0)
  note          String?
  subcategoryId String?
  subcategory   SupplierSubcategory? @relation(fields: [subcategoryId], references: [id])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  materialCosts MaterialCost[]
  services      SupplierService[]
}

// ─── SRM: Supplier Categories ───────────────────────────────────
model SupplierCategory {
  id        String   @id @default(cuid())
  name      String   @unique
  icon      String?
  createdAt DateTime @default(now())
  subcategories SupplierSubcategory[]
}

model SupplierSubcategory {
  id         String   @id @default(cuid())
  name       String
  categoryId String
  category   SupplierCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  suppliers  Supplier[]
  services   SupplierService[]
}

// ─── SRM: Supplier Services + Price Lists ───────────────────────
model SupplierService {
  id            String   @id @default(cuid())
  supplierId    String
  supplier      Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  subcategoryId String?
  subcategory   SupplierSubcategory? @relation(fields: [subcategoryId], references: [id])
  name          String
  description   String?
  unit          String   @default("عدد")
  createdAt     DateTime @default(now())
  priceLists    PriceList[]
}

model PriceList {
  id            String   @id @default(cuid())
  serviceId     String
  service       SupplierService @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  price         Float
  minQuantity   Int      @default(1)
  note          String?
  validFrom     DateTime @default(now())
  validTo       DateTime?
  createdAt     DateTime @default(now())
}

// ─── Products / Services ────────────────────────────────────────
model Product {
  id          String      @id @default(cuid())
  name        String
  description String?
  unit        String      @default("عدد")
  basePrice   Float?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  orderItems  OrderItem[]
}

// ─── Orders ─────────────────────────────────────────────────────
model Order {
  id          String       @id @default(cuid())
  number      Int          @unique // sequential display #1, #2 ... (computed in code)
  customerId  String
  customer    Customer     @relation(fields: [customerId], references: [id])
  status      String       @default("pending_design") // pending_design | in_printing | warehouse_logistics | completed | archived | cancelled
  splitMode   String       @default("grouped") // grouped | separated
  priority    String       @default("normal") // normal | urgent
  endDate     DateTime? // overall order end date (optional)
  noEndDate   Boolean      @default(false)
  totalAmount Float        @default(0)
  paidAmount  Float        @default(0)
  address     String?      // Phase 16: آدرس تحویل سفارش (پیش‌فرض: آدرس مشتری)
  // Phase 17: گیت خروج از انبار — مالی یا فاکتور را تسویه می‌کند یا علامت
  // «فاکتور همراه بسته ارسال می‌شود» می‌زند؛ تا آن موقع انبار اجازهٔ خروج ندارد.
  invoiceWithPackage Boolean @default(false)
  note        String?
  designerNote String? // note from designer, visible to all modules
  createdBy   String?
  // ─── Phase 12: تخصیص مسئوِستان + ثبت‌کننده ──
  // طراح/چاپ «اختصاصی» این سفارش — null = استخر عمومی (همهٔ همان ماژول می‌بینند).
  // وقتی مدیر هنگام ثبت، کاربر X را انتخاب می‌کند، سفارش فقط در پنل X ظاهر
  // می‌شود و X تنها مجری مجاز آن مرحله است (گاردهای 403 در action routes).
  assignedDesignerId String?
  assignedDesigner   User?  @relation("OrderDesigner", fields: [assignedDesignerId], references: [id], onDelete: SetNull)
  assignedPrinterId  String?
  assignedPrinter    User?  @relation("OrderPrinter", fields: [assignedPrinterId], references: [id], onDelete: SetNull)
  createdById        String?
  createdByUser      User?  @relation("OrderCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  items       OrderItem[]
  preInvoices PreInvoice[]
  invoice     Invoice?
  tasks         Task[]
  qcReports     QcReport[]
  materialCosts MaterialCost[]
  // Phase 15: دفتر درآمد — هر تغییر «پرداخت‌شدهٔ» سفارش با تفاضل هوشمند
  revenueLogs   RevenueLog[]
  // Phase 14: رویدادهای گردش کار (تاریخچهٔ واقعی سفارش)
  events        OrderEvent[]
  // Phase 16: اقلام این سفارش که در بسته‌ها قرار گرفته‌اند
  packageItems  PackageItem[]
}

// ─── Phase 15: دفتر درآمد (RevenueLog) ────────────────────────
// «درآمد» = هر عددی که به‌عنوان پرداخت‌شدهٔ مشتری ثبت شود.
// سناریوی ادیت هوشمند: مشتری ۱۰۰۰ داد؛ فردا ۵۰۰۰ دیگر داد و ادمید به‌جای
// ثبت جدا، عدد کل را ۶۰۰۰ کرد → سیستم خودش diff=۵۰۰۰ را به‌عنوان
// «درآمد جدید در این ساعت/تاریخ، توسط این کارمند، از این ماژول» لاگ می‌کند.
//   amount      = تفاضلِ هوشمند (+درآمد جدید / -اصلاح کاهشی)
//   totalAfter  = snapshot کل پرداخت‌شدهٔ سفارش بعد از این تغییر
//   module      = finance | admin | logistics — کدام ماژول عدد را زد
//   createdByName = snapshot نام کارمند
model RevenueLog {
  id            String   @id @default(cuid())
  orderId       String
  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  amount        Float    // signed diff: +revenue / -reversal
  totalAfter    Float    @default(0) // order.paidAmount پس از این تغییر
  module        String   @default("finance") // finance | admin | logistics
  method        String?  // cash | transfer | cheque
  note          String?
  createdById   String?
  createdByUser User?    @relation("RevenueCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdByName String?  // snapshot
  createdAt     DateTime @default(now())

  @@index([createdAt])
  @@index([orderId])
  @@index([module])
}

// ─── Phase 14: رویدادهای سفارش (audit واقعی گردش کار) ─────────
// هر اقدام ماژولی روی سفارش با «مرحله + تاریخ + عامل» ثبت می‌شود:
//   created | design_completed | sent_to_print | material_confirmed |
//   print_completed | sent_to_warehouse | qc_reported | qc_reviewed |
//   qc_returned | status_changed | reassigned | cost_registered
// رویدادهای sensitive (مالی: cost_registered و…) فقط برای مالی/مستر
// در GET بازگردانده می‌شوند — ادمین داخلی از اسناد مالی خبردار نمی‌شود.
// actorName اسنپ‌شات است تا حذف کاربر متن را نبکشد (SetNull روی رابطه).
model OrderEvent {
  id          String   @id @default(cuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  type        String   // created | design_completed | sent_to_print | material_confirmed | print_completed | sent_to_warehouse | qc_reported | qc_reviewed | qc_returned | status_changed | reassigned | cost_registered | cost_invoiced | cost_approved | cost_rejected | payment_recorded
  stage       String?  // design | print | warehouse | qc | finance — مرحلهٔ مربوط به رویداد
  actorId     String?
  actor       User?    @relation("OrderEventActor", fields: [actorId], references: [id], onDelete: SetNull)
  actorName   String?  // اسنپ‌شات نام عامل
  title       String   // متن اصلی رویداد
  description String?  // جزئیات اختیاری
  sensitive   Boolean  @default(false) // true = مالی — برای ادمین داخلی مخفی
  createdAt   DateTime @default(now())
}

// ─── QC Reports (quality control) ──────────────────────────────
model QcReport {
  id            String   @id @default(cuid())
  orderId       String
  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fromModule    String   // designer | print | warehouse
  description   String
  status        String   @default("pending") // pending | reviewing | approved | rejected
  returnStage   String?  // which stage to return to after QC (design | print | warehouse)
  reviewedBy    String?
  reviewedAt    DateTime?
  reportedBy    String?
  // ─── Phase 12: انتساب واقعی گزارش/بررسی به کاربر (آمار کارمند) ──
  reportedById  String?
  reportedByUser User? @relation("QcReporter", fields: [reportedById], references: [id], onDelete: SetNull)
  reviewedById  String?
  reviewedByUser User? @relation("QcReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  createdAt     DateTime @default(now())
}

// ─── Expense Types (managed by admin) ──────────────────────────
model ExpenseType {
  id            String        @id @default(cuid())
  name          String        @unique
  isDefault     Boolean       @default(false)
  createdAt     DateTime      @default(now())
  materialCosts MaterialCost[]
}

// ─── Material / Print Costs ────────────────────────────────────
// ─── Phase 15: هزینهٔ جامع (روی سفارش + آزاد) ───────────────────
// دو نوع هزینه:
//   ۱) هزینه روی سفارش (orderId مقدار دارد): چاپ/متریال/انبار/لجستیک/مالی
//      ثبت می‌کنند؛ مالی تأیید می‌کند (pending → approved/rejected).
//      includeInInvoice=true → هزینه مثل یک آیتم در فاکتور/پیش‌فاکتور
//      می‌نشیند و به مبلغ سفارش اضافه می‌شود (خواستهٔ صریح کاربر).
//   ۲) هزینهٔ آزاد (orderId=null): هزینهٔ اداری/جاری (کرایه، حقوق، …).
//      دستهٔ آن expenseTypeId است (حقوق هاردکد-default). فقط مالی ثبت
//      می‌کند → وضعیت مستقیم approved می‌گیرد (نیاز به تأیید ندارد).
// createdById + createdByName: «کی، کدام ماژول، چه زمانی» — هستهٔ لاگ مالی.
model MaterialCost {
  id           String       @id @default(cuid())
  orderId      String?      // null = هزینهٔ آزاد (بدون سفارش)
  order        Order?       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  supplierId   String?
  supplier     Supplier?    @relation(fields: [supplierId], references: [id])
  expenseTypeId String?
  expenseType  ExpenseType? @relation(fields: [expenseTypeId], references: [id])
  title        String?      // نام هزینه (مثل نام آیتم)
  description  String?
  amount       Float
  fileUrl1     String?
  fileUrl2     String?
  status       String       @default("pending") // pending | approved | rejected
  module       String       @default("print") // print | material | warehouse | finance | logistics
  includeInInvoice Boolean  @default(false) // هزینه در فاکتور/پیش‌فاکتور سفارش بنشیند
  preInvoiceId String?      // سند هدفِ تزریق هزینه (چند-سندی: کدام پیش‌فاکتور)
  createdBy    String?      // legacy: snapshot آی‌دی
  createdById  String?
  createdByUser User?       @relation("CostCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdByName String?     // snapshot نام کارمند (حذف کاربر متن را نمی‌کشد)
  // Phase 16: هزینهٔ خرید مادهٔ اولیهٔ خاص → با تأیید مالی، موجودی انبار زیاد می‌شود
  materialId   String?
  material     Material?   @relation(fields: [materialId], references: [id], onDelete: SetNull)
  materialQty  Float?      // تعداد/مقدار ورود به انبار (واحد ماده)
  // ─── Phase 16: حقوق و دستمزد — سند هزینهٔ ناشی از پرداخت حقوق/مساعده ──
  payrollEntry  PayrollEntry?  @relation("EntryCost")
  payrollAdvance PayrollAdvance? @relation("AdvanceCost")
  // Phase 16: گردش انبار ناشی از تأیید این هزینهٔ خرید ماده
  stockMoves   MaterialStockMove[]
  createdAt    DateTime     @default(now())
  // Phase 14: پیوست‌های واقعی (آپلود فایل) — به‌جای دو باکس لینک
  attachments  CostAttachment[]

  @@index([createdAt])
  @@index([status])
  @@index([orderId])
}

// ─── Phase 14: پیوست هزینه (فایل آپلودشده) ─────────────────────
// url = مسیر عمومی فایل (/uploads/...) — سرو از public/uploads.
// fileName نام اصلی فایل کاربر؛ mime/size برای آیکون و اعتبارسنجی.
model CostAttachment {
  id           String       @id @default(cuid())
  costId       String
  cost         MaterialCost @relation(fields: [costId], references: [id], onDelete: Cascade)
  url          String
  fileName     String
  mimeType     String       @default("")
  size         Int          @default(0)
  createdAt    DateTime     @default(now())
}

// ─── Order Items (the core unit that flows between modules) ─────
model OrderItem {
  id             String   @id @default(cuid())
  orderId        String
  order          Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId      String
  product        Product  @relation(fields: [productId], references: [id])
  quantity       Int      @default(1)
  pricePerUnit   Float    @default(0)
  totalAmount    Float    @default(0)
  note           String?
  description    String?
  stage          String   @default("design") // design | print | warehouse | completed | archive
  needsMaterial    Boolean  @default(false)
  materialConfirmed Boolean @default(false) // print module: material procured?
  designStartDate DateTime?
  designEndDate   DateTime?
  printStartDate  DateTime?
  printEndDate    DateTime?
  // Phase 9: لحظهٔ واقعی تکمیل هر مرحله توسط طراح/چاپ (audit)
  designCompletedAt DateTime?
  printCompletedAt  DateTime?
  // Phase 12: «کی» تکمیل کرد — آمار فعالیت کارمند + مالکیت تاریخی آیتم.
  designCompletedBy String?
  designCompletedByUser User? @relation("ItemDesignCompleter", fields: [designCompletedBy], references: [id], onDelete: SetNull)
  printCompletedBy  String?
  printCompletedByUser  User? @relation("ItemPrintCompleter", fields: [printCompletedBy], references: [id], onDelete: SetNull)
  // ─── Phase 13: مجری اختصاصی «همین آیتم» ──
  // مسیر حقیقت روتینگ: هر آیتم طراح/چاپ خودش را دارد. null → فال‌بک
  // به تخصیص سفارش (assignedDesignerId/assignedPrinterId) → استخر عمومی.
  designAssigneeId String?
  designAssigneeUser User? @relation("ItemDesignAssignee", fields: [designAssigneeId], references: [id], onDelete: SetNull)
  printAssigneeId  String?
  printAssigneeUser  User? @relation("ItemPrintAssignee", fields: [printAssigneeId], references: [id], onDelete: SetNull)
  // Phase 10: پیش‌فاکتورهای به‌ازای همین آیتم (SetNull → حذف آیتم، سند را نمی‌کشد)
  preInvoices    PreInvoice[]
  // Phase 16: اقلام این آیتم در بسته‌های ارسال
  packageItems   PackageItem[]
  createdAt      DateTime @default(now())
}

// ─── Pre-Invoice (پیش فاکتور) ──────────────────────────────────
// ─── PreInvoice (پیش‌فاکتور) — بازسازی فاز ۷ ─────────────────────────────
// موجودیت عملیاتی پیش‌فاکتور چاپخانه:
//   چرخهٔ وضعیت: draft → sent → approved → converted (یا rejected)
//   شماره‌گذاری اتمیک از Counter، اعتبار زمانی، اقلام با قیمت واحد/تخفیف،
//   مالیات، پیش‌پرداخت و سنپ‌شات مشتری. مبلغ پرداختی سفارش به‌صورت
//   افزایشی/کاهشی (delta) با order.paidAmount همگام می‌شود.
model PreInvoice {
  id             String    @id @default(cuid())
  number         Int       @unique
  orderId        String
  order          Order     @relation(fields: [orderId], references: [id])
  customerId     String
  customer       Customer  @relation(fields: [customerId], references: [id])
  // Phase 10: قلمِ مرتبط برای پیش‌فاکتور «به‌ازای آیتم» (سفارش مجزا/چند-مشتری).
  // null = پیش‌فاکتور کل گروه (سفارش گروهی تک-مشتری). SetNull: حذف آیتم،
  // سند را زنده نگه می‌دارد و فقط لینک را رها می‌کند.
  itemId         String?
  item           OrderItem? @relation(fields: [itemId], references: [id], onDelete: SetNull)
  // draft | sent | approved | rejected | converted
  status         String    @default("draft")
  issueDate      DateTime  @default(now())
  validUntil     DateTime?
  // JSON: [{name, quantity, unit, unitPrice, discount, total}]
  items          String
  subtotal       Float     @default(0)
  discountAmount Float     @default(0)
  taxRate        Float     @default(0) // درصد مالیات (۰ تا ۱۰۰)
  taxAmount      Float     @default(0)
  totalAmount    Float     @default(0) // subtotal - discount + tax
  paidAmount     Float     @default(0) // پیش‌پرداخت دریافتی
  notes          String?
  terms          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

// ─── Invoice (فاکتور) — بازسازی فاز ۹ ─────────────────────────────
// فاکتور نهایی: فقط زمانی صادر می‌شود که سفارش به مرحلهٔ انبار/لجستیک
// (یا بعدتر) رسیده باشد. ساختار مالی همان پیش‌فاکتور است + سررسید پرداخت.
//   چرخهٔ وضعیت: draft → issued → paid (یا cancelled)
//   source: manual (صدور مستقیم) | pre_invoice (تبدیل از پیش‌فاکتور)
//   یک فاکتور نهایی برای هر سفارش (orderId یکتا) — در تکرار خطای 409.
//   order.paidAmount به‌صورت افزایشی (delta) همگام می‌شود.
model Invoice {
  id             String   @id @default(cuid())
  number         Int      @unique
  orderId        String   @unique
  order          Order    @relation(fields: [orderId], references: [id])
  customerId     String
  customer       Customer @relation(fields: [customerId], references: [id])
  // draft | issued | paid | cancelled
  status         String   @default("issued")
  issueDate      DateTime @default(now())
  dueDate        DateTime? // سررسید پرداخت
  items          String   // JSON: [{name, quantity, unit, unitPrice, discount, total}]
  subtotal       Float    @default(0)
  discountAmount Float    @default(0)
  taxRate        Float    @default(0) // درصد (۰-۱۰۰)
  taxAmount      Float    @default(0)
  totalAmount    Float    @default(0) // subtotal - discount + tax
  paidAmount     Float    @default(0)
  notes          String?
  terms          String?
  source         String   @default("manual") // manual | pre_invoice
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// ─── Tasks ──────────────────────────────────────────────────────
model Task {
  id          String   @id @default(cuid())
  title       String
  description String?
  status      String   @default("todo") // todo | in_progress | done
  priority    String   @default("normal") // normal | urgent
  dueDate     DateTime?
  module      String   @default("admin") // admin | designer | print | warehouse | finance | qc | crm | srm
  orderId       String?
  order         Order?   @relation(fields: [orderId], references: [id])
  customerId    String?
  // Phase 4 (R9): assignedTo is now a real FK to User — referential
  // integrity is enforced by SQLite; API validates the user exists + active.
  assignedTo    String?
  assignedUser  User?    @relation("TaskAssignee", fields: [assignedTo], references: [id])
  // Phase 12: مهر زمانی «انجام شد» — آمار روزانهٔ کارمند (چه کسی، چه روزی)
  completedAt   DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ─── Notifications (real) ───────────────────────────────────────
model Notification {
  id        String   @id @default(cuid())
  title     String
  message   String
  type      String   @default("info") // info | success | warning | error
  read      Boolean  @default(false)
  // Phase 12: اعلان هدفمند — null = عمومی (همه)، غیر-null = فقط همان کاربر
  userId    String?
  link      String? // nav target e.g. "admin:orders"
  createdAt DateTime @default(now())
  reads     NotificationRead[]

  @@index([userId, createdAt])
}

// Phase 17: وضعیت خواندنِ «هر-کاربر» — اعلان عمومی وقتی کاربری می‌خواند
// نباید برای بقیه خوانده‌شده شود. ردیف این جدول = آن کاربر آن اعلان را خوانده.
model NotificationRead {
  id             String   @id @default(cuid())
  userId         String
  notificationId String
  readAt         DateTime @default(now())
  user           User @relation(fields: [userId], references: [id], onDelete: Cascade)
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@unique([userId, notificationId])
  @@index([userId])
}

// ─── Finance: Expenses & Payments ───────────────────────────────
model Expense {
  id        String   @id @default(cuid())
  title     String
  amount    Float
  category  String?
  date      DateTime @default(now())
  note      String?
  createdAt DateTime @default(now())
}

model Payment {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])
  orderId    String?
  invoiceId  String?
  amount     Float
  status     String   @default("awaiting") // awaiting | validated
  method     String?
  date       DateTime @default(now())
  note       String?
  createdAt  DateTime @default(now())
}

// ─── Audit Log ──────────────────────────────────────────────────
model AuditLog {
  id       String   @id @default(cuid())
  employee String
  action   String // CREATE | UPDATE | DELETE
  path     String
  status   Int
  date     DateTime @default(now())
}

// ─── CRM: Deals (Sales Pipeline) ────────────────────────────────
model Deal {
  id               String      @id @default(cuid())
  title            String
  customerId       String
  customer         Customer    @relation(fields: [customerId], references: [id])
  value            Float       @default(0)
  stage            String      @default("lead") // lead | qualified | proposal | negotiation | won | lost
  probability      Int         @default(0) // 0-100
  expectedCloseDate DateTime?
  source           String?     // walk-in | phone | referral | online | other
  description      String?
  assignedTo       String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  activities       Activity[]
}

// ─── CRM: Activities (calls, emails, meetings, notes, visits) ──
model Activity {
  id          String    @id @default(cuid())
  type        String    // call | email | meeting | note | visit
  title       String
  description String?
  customerId  String?
  customer    Customer? @relation(fields: [customerId], references: [id])
  dealId      String?
  deal        Deal?     @relation(fields: [dealId], references: [id])
  date        DateTime  @default(now())
  createdAt   DateTime  @default(now())
}

// ─── R3: Atomic sequential counter (replaces aggregate _max + 1) ────────────
// Pre-R3: nextNumber did `db.order.aggregate({ _max: { number: true } })` + 1.
// Two concurrent writers could both read the same max before either writes
// (race condition → duplicate order numbers). Even inside $transaction, the
// _max approach scans the full table (O(n)) and depends on write-lock
// serialization for correctness. The Counter model uses an atomic upsert +
// increment (single SQL UPDATE, O(1), inherently race-free even WITHOUT a
// transaction wrapper). Seeds: order→current max order number, preInvoice→
// current max preInvoice number, invoice→current max invoice number.
// Gaps (deleted records) don't reuse numbers — counter only moves forward.
model Counter {
  id    String  @id           // "order" | "preInvoice" | "invoice"
  next  Int    @default(1)    // next number to assign
}

// ─── Day notes (calendar) ──────────────────────────────────────────────────
// Per-day sticky note rendered in the Day Detail Modal + a marker dot on the
// calendar cell. `date` is a LOCAL yyyy-MM-dd string key (unique) — kept as
// String (not DateTime) so no timezone drift can ever shift a note to the
// adjacent day. color: default | rose | amber | emerald | blue.
model DayNote {
  id        String   @id @default(cuid())
  date      String   @unique // "yyyy-MM-dd" local day key
  content   String   @default("")
  color     String   @default("default")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ═════════════════════════════════════════════════════════════════
// PHASE 16 — حقوق و دستمزد (Payroll)
// ═════════════════════════════════════════════════════════════════
// چرخهٔ کامل: دورهٔ ماهانه (گریگوری "2026-09") → ورودی هر کارمند
// (پایه + اضافه‌کاری + پاداش − کمکرد − بیمه − مالیات − کسر مساعده
// = خالص) → «پرداخت» → ثبت خودکار MaterialCost با دستهٔ «حقوق»
// (هزینهٔ سیستم) + نوتیف به کارمند. مساعده: هزینهٔ فوری؛ در دورهٔ
// بعد به‌صورت FIFO (قدیمی‌ترین‌ها) کسر می‌شود — بدون شمارش دوباره.

model PayrollPeriod {
  id        String   @id @default(cuid())
  key       String   @unique // "2026-09" (گریگوری)
  startDate String   // yyyy-MM-dd لوکال (اول ماه)
  endDate   String   // yyyy-MM-dd لوکال (آخر ماه)
  status    String   @default("open") // open | paid | closed
  note      String?
  // اسنپ‌شات لحظهٔ پرداخت (تاریخچه حتی اگر ورودی‌ها بعداً تغییر کند)
  totalNet  Float    @default(0)
  entriesCount Int  @default(0)
  paidAt    DateTime?
  paidById  String?
  paidByUser User?  @relation("PayrollPeriodPayer", fields: [paidById], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  entries   PayrollEntry[]
  advancesDeducted PayrollAdvance[]

  @@index([status])
}

model PayrollEntry {
  id             String   @id @default(cuid())
  periodId       String
  period         PayrollPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  baseSalary     Float    @default(0) // حقوق پایه (اسنپ‌شات از قرارداد)
  overtimeHours  Float    @default(0) // ساعت اضافه‌کاری
  overtimeRate   Float    @default(0) // نرخ هر ساعت
  bonus          Float    @default(0) // پاداش / کارکرد
  deduction      Float    @default(0) // کمکرد / جریمه
  insurance      Float    @default(0) // بیمهٔ سهم کارمند
  tax            Float    @default(0) // مالیات
  advanceDeducted Float  @default(0) // مساعده‌های کسرشدهٔ این دوره
  netPay         Float    @default(0) // خالص پرداختی (محاسبه‌شده)
  modulesSnapshot String? // "designer,print" — ماژول‌های کارمند در زمان پرداخت
  note           String?
  status         String   @default("draft") // draft | paid
  paidAt         DateTime?
  costId         String?  @unique // سند هزینهٔ ثبت‌شده (MaterialCost)
  cost           MaterialCost? @relation("EntryCost", fields: [costId], references: [id], onDelete: SetNull)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([periodId, userId])
  @@index([userId])
}

model PayrollAdvance {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation("AdvanceReceiver", fields: [userId], references: [id], onDelete: Cascade)
  amount    Float
  note      String?
  // هزینهٔ فوریِ مساعده (وقتی پول از شرکت خارج شد)
  costId    String?  @unique
  cost      MaterialCost? @relation("AdvanceCost", fields: [costId], references: [id], onDelete: SetNull)
  // کسر در دورهٔ حقوق:
  deductedPeriodId String?
  deductedPeriod   PayrollPeriod? @relation(fields: [deductedPeriodId], references: [id], onDelete: SetNull)
  deductedAt DateTime?
  createdById String?
  createdByUser User? @relation("AdvanceCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdByName String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([deductedPeriodId])
}

// ═════════════════════════════════════════════════════════════════
// PHASE 16 — انبار و لجستیک: بسته‌بندی + بج QR + ارسال + تحویل
// ═════════════════════════════════════════════════════════════════
// نقش ماژول: دریافت کالا از چاپ → بسته‌بندی (ساخت بسته از اقلام
// سفارش‌ها — یک بسته می‌تواند چند سفارشِ یک مشتری را داشته باشد) →
// بج QR (صفحهٔ عمومی /?pkg=CODE) → ارسال (پیک/پست + شماره پیگیری) →
// تحویل (+ پول در محل → درآمد). تحویل کامل = تکمیل سفارش.

model Package {
  id            String   @id @default(cuid())
  code          String   @unique // "PKG-7K2M9X" — توکن QR (غیرقابل حدس)
  seq           Int      // شمارهٔ نمایشی #1, #2 …
  address       String   // آدرس تحویل بسته
  receiverName  String?  // نام گیرنده (اگر غیر از مشتری)
  receiverPhone String?
  contentsNote  String?  // شرح کلی محتویات (روی بج)
  courier       String?  // پیک / پست / تیپاکس…
  trackingNo    String?  // شمارهٔ پیگیری
  status        String   @default("packing") // packing | ready | sent | delivered | cancelled
  codAmount     Float    @default(0)  // پول در محل
  codCollected  Boolean  @default(false)
  note          String?
  packedAt      DateTime @default(now())
  sentAt        DateTime?
  deliveredAt   DateTime?
  createdById   String?
  createdByUser User?    @relation("PackageCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdByName String?
  items         PackageItem[]

  @@index([status])
  @@index([seq])
}

model PackageItem {
  id           String   @id @default(cuid())
  packageId    String
  package      Package  @relation(fields: [packageId], references: [id], onDelete: Cascade)
  orderId      String
  order        Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderItemId  String?  // null = برای سفارش‌های بدون آیتم ساختاری
  orderItem    OrderItem? @relation(fields: [orderItemId], references: [id], onDelete: SetNull)
  quantity     Int      @default(1)
  createdAt    DateTime @default(now())

  @@unique([packageId, orderItemId])
  @@index([orderId])
}

// ─── Phase 16: موجودی مواد اولیهٔ انبار ──────────────────────
// گردش انبار: خرید ماده (هزینهٔ متریال تأییدشده → +qty) / مصرف
// (خروج دستی). «کم‌موجود» = quantity < minQuantity → هشدار داشبورد.
model Material {
  id          String   @id @default(cuid())
  name        String   @unique
  unit        String   @default("عدد") // عدد | ورق | کیلوگرم | لیتر | متر…
  quantity    Float    @default(0)
  minQuantity Float    @default(0)
  note        String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  moves       MaterialStockMove[]
  costs       MaterialCost[]

  @@index([isActive])
}

model MaterialStockMove {
  id            String   @id @default(cuid())
  materialId    String
  material      Material @relation(fields: [materialId], references: [id], onDelete: Cascade)
  delta         Float    // + ورود / − خروج
  reason        String?  // خرید / مصرف چاپ / ضایعات / اصلاح…
  costId        String?  // اگر از تأیید هزینهٔ خرید آمده
  cost          MaterialCost? @relation(fields: [costId], references: [id], onDelete: SetNull)
  createdById   String?
  createdByName String?
  createdAt     DateTime @default(now())

  @@index([materialId, createdAt])
}
