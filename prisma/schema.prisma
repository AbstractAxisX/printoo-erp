// Printoo24 ERP — Prisma schema
// SQLite datasource

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─── Users / Auth ───────────────────────────────────────────────
model User {
  id             String   @id @default(cuid())
  name           String
  email          String   @unique
  password       String
  role           String   @default("master") // master | admin | designer | print | warehouse | finance | qc | crm | srm
  phone          String?
  avatar         String?
  status         String   @default("active") // active | inactive
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  assignedTasks  Task[]   @relation("TaskAssignee")
}

// ─── CRM: Customers ─────────────────────────────────────────────
model Customer {
  id          String       @id @default(cuid())
  name        String
  phone       String
  isFavorite  Boolean      @default(false)
  balanceDue  Float        @default(0)
  note        String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  orders      Order[]
  preInvoices PreInvoice[]
  invoices    Invoice[]
  payments    Payment[]
  deals       Deal[]
  activities  Activity[]
}

// ─── SRM: Suppliers ─────────────────────────────────────────────
model Supplier {
  id            String   @id @default(cuid())
  name          String
  phone         String?
  contactPerson String?
  address       String?
  balanceDue    Float    @default(0)
  note          String?
  subcategoryId String?
  subcategory   SupplierSubcategory? @relation(fields: [subcategoryId], references: [id])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  materialCosts MaterialCost[]
  services      SupplierService[]
}

// ─── SRM: Supplier Categories ───────────────────────────────────
model SupplierCategory {
  id        String   @id @default(cuid())
  name      String   @unique
  icon      String?
  createdAt DateTime @default(now())
  subcategories SupplierSubcategory[]
}

model SupplierSubcategory {
  id         String   @id @default(cuid())
  name       String
  categoryId String
  category   SupplierCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  suppliers  Supplier[]
  services   SupplierService[]
}

// ─── SRM: Supplier Services + Price Lists ───────────────────────
model SupplierService {
  id            String   @id @default(cuid())
  supplierId    String
  supplier      Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  subcategoryId String?
  subcategory   SupplierSubcategory? @relation(fields: [subcategoryId], references: [id])
  name          String
  description   String?
  unit          String   @default("عدد")
  createdAt     DateTime @default(now())
  priceLists    PriceList[]
}

model PriceList {
  id            String   @id @default(cuid())
  serviceId     String
  service       SupplierService @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  price         Float
  minQuantity   Int      @default(1)
  note          String?
  validFrom     DateTime @default(now())
  validTo       DateTime?
  createdAt     DateTime @default(now())
}

// ─── Products / Services ────────────────────────────────────────
model Product {
  id          String      @id @default(cuid())
  name        String
  description String?
  unit        String      @default("عدد")
  basePrice   Float?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  orderItems  OrderItem[]
}

// ─── Orders ─────────────────────────────────────────────────────
model Order {
  id          String       @id @default(cuid())
  number      Int          @unique // sequential display #1, #2 ... (computed in code)
  customerId  String
  customer    Customer     @relation(fields: [customerId], references: [id])
  status      String       @default("pending_design") // pending_design | in_printing | warehouse_logistics | completed | archived | cancelled
  splitMode   String       @default("grouped") // grouped | separated
  priority    String       @default("normal") // normal | urgent
  endDate     DateTime? // overall order end date (optional)
  noEndDate   Boolean      @default(false)
  totalAmount Float        @default(0)
  paidAmount  Float        @default(0)
  note        String?
  designerNote String? // note from designer, visible to all modules
  createdBy   String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  items       OrderItem[]
  preInvoices PreInvoice[]
  invoice     Invoice?
  tasks         Task[]
  qcReports     QcReport[]
  materialCosts MaterialCost[]
}

// ─── QC Reports (quality control) ──────────────────────────────
model QcReport {
  id            String   @id @default(cuid())
  orderId       String
  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fromModule    String   // designer | print | warehouse
  description   String
  status        String   @default("pending") // pending | reviewing | approved | rejected
  returnStage   String?  // which stage to return to after QC (design | print | warehouse)
  reviewedBy    String?
  reviewedAt    DateTime?
  reportedBy    String?
  createdAt     DateTime @default(now())
}

// ─── Expense Types (managed by admin) ──────────────────────────
model ExpenseType {
  id            String        @id @default(cuid())
  name          String        @unique
  isDefault     Boolean       @default(false)
  createdAt     DateTime      @default(now())
  materialCosts MaterialCost[]
}

// ─── Material / Print Costs ────────────────────────────────────
model MaterialCost {
  id           String       @id @default(cuid())
  orderId      String
  order        Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  supplierId   String?
  supplier     Supplier?    @relation(fields: [supplierId], references: [id])
  expenseTypeId String?
  expenseType  ExpenseType? @relation(fields: [expenseTypeId], references: [id])
  description  String?
  amount       Float
  fileUrl1     String?
  fileUrl2     String?
  status       String       @default("pending") // pending | approved | rejected
  module       String       @default("print") // print | warehouse
  createdBy    String?
  createdAt    DateTime     @default(now())
}

// ─── Order Items (the core unit that flows between modules) ─────
model OrderItem {
  id             String   @id @default(cuid())
  orderId        String
  order          Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId      String
  product        Product  @relation(fields: [productId], references: [id])
  quantity       Int      @default(1)
  pricePerUnit   Float    @default(0)
  totalAmount    Float    @default(0)
  note           String?
  description    String?
  stage          String   @default("design") // design | print | warehouse | completed | archive
  needsMaterial    Boolean  @default(false)
  materialConfirmed Boolean @default(false) // print module: material procured?
  designStartDate DateTime?
  designEndDate   DateTime?
  printStartDate  DateTime?
  printEndDate    DateTime?
  createdAt      DateTime @default(now())
}

// ─── Pre-Invoice (پیش فاکتور) ──────────────────────────────────
model PreInvoice {
  id          String   @id @default(cuid())
  number      Int      @unique
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id])
  customerId  String
  customer    Customer @relation(fields: [customerId], references: [id])
  totalAmount Float    @default(0)
  paidAmount  Float    @default(0)
  date        DateTime @default(now())
  items       String // JSON string: [{name, quantity, total, paid}]
  createdAt   DateTime @default(now())
}

// ─── Invoice (فاکتور) ───────────────────────────────────────────
model Invoice {
  id             String   @id @default(cuid())
  number         Int      @unique
  orderId        String   @unique
  order          Order    @relation(fields: [orderId], references: [id])
  customerId     String
  customer       Customer @relation(fields: [customerId], references: [id])
  totalAmount    Float    @default(0)
  paidAmount     Float    @default(0)
  discountAmount Float    @default(0)
  date           DateTime @default(now())
  items          String // JSON string
  createdAt      DateTime @default(now())
}

// ─── Tasks ──────────────────────────────────────────────────────
model Task {
  id          String   @id @default(cuid())
  title       String
  description String?
  status      String   @default("todo") // todo | in_progress | done
  priority    String   @default("normal") // normal | urgent
  dueDate     DateTime?
  module      String   @default("admin") // admin | designer | print | warehouse | finance | qc | crm | srm
  orderId       String?
  order         Order?   @relation(fields: [orderId], references: [id])
  customerId    String?
  // Phase 4 (R9): assignedTo is now a real FK to User — referential
  // integrity is enforced by SQLite; API validates the user exists + active.
  assignedTo    String?
  assignedUser  User?    @relation("TaskAssignee", fields: [assignedTo], references: [id])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ─── Notifications (real) ───────────────────────────────────────
model Notification {
  id        String   @id @default(cuid())
  title     String
  message   String
  type      String   @default("info") // info | success | warning | error
  read      Boolean  @default(false)
  userId    String?
  link      String? // nav target e.g. "admin:orders"
  createdAt DateTime @default(now())
}

// ─── Finance: Expenses & Payments ───────────────────────────────
model Expense {
  id        String   @id @default(cuid())
  title     String
  amount    Float
  category  String?
  date      DateTime @default(now())
  note      String?
  createdAt DateTime @default(now())
}

model Payment {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])
  orderId    String?
  invoiceId  String?
  amount     Float
  status     String   @default("awaiting") // awaiting | validated
  method     String?
  date       DateTime @default(now())
  note       String?
  createdAt  DateTime @default(now())
}

// ─── Audit Log ──────────────────────────────────────────────────
model AuditLog {
  id       String   @id @default(cuid())
  employee String
  action   String // CREATE | UPDATE | DELETE
  path     String
  status   Int
  date     DateTime @default(now())
}

// ─── CRM: Deals (Sales Pipeline) ────────────────────────────────
model Deal {
  id               String      @id @default(cuid())
  title            String
  customerId       String
  customer         Customer    @relation(fields: [customerId], references: [id])
  value            Float       @default(0)
  stage            String      @default("lead") // lead | qualified | proposal | negotiation | won | lost
  probability      Int         @default(0) // 0-100
  expectedCloseDate DateTime?
  source           String?     // walk-in | phone | referral | online | other
  description      String?
  assignedTo       String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  activities       Activity[]
}

// ─── CRM: Activities (calls, emails, meetings, notes, visits) ──
model Activity {
  id          String    @id @default(cuid())
  type        String    // call | email | meeting | note | visit
  title       String
  description String?
  customerId  String?
  customer    Customer? @relation(fields: [customerId], references: [id])
  dealId      String?
  deal        Deal?     @relation(fields: [dealId], references: [id])
  date        DateTime  @default(now())
  createdAt   DateTime  @default(now())
}

// ─── R3: Atomic sequential counter (replaces aggregate _max + 1) ────────────
// Pre-R3: nextNumber did `db.order.aggregate({ _max: { number: true } })` + 1.
// Two concurrent writers could both read the same max before either writes
// (race condition → duplicate order numbers). Even inside $transaction, the
// _max approach scans the full table (O(n)) and depends on write-lock
// serialization for correctness. The Counter model uses an atomic upsert +
// increment (single SQL UPDATE, O(1), inherently race-free even WITHOUT a
// transaction wrapper). Seeds: order→current max order number, preInvoice→
// current max preInvoice number, invoice→current max invoice number.
// Gaps (deleted records) don't reuse numbers — counter only moves forward.
model Counter {
  id    String  @id           // "order" | "preInvoice" | "invoice"
  next  Int    @default(1)    // next number to assign
}
