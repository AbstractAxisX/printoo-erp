[Unit]
Description=Printoo24 Admin (ERP) — Database Backup Timer (every 3h, Iran time)

[Timer]
# هر ۳ ساعت در دقیقهٔ صفر، به وقت ایران: 00، 03، 06، 09، 12، 15، 18، 21
# (زون زمانی داخل خود عبارت تقویمی — سازگار با systemd 255 که Timezone= جدا ندارد)
OnCalendar=*-*-* 00/3:00:00 Asia/Tehran
# اگر سرور خاموش بود و زمانشان گذشت، بعد از روشن شدن همان‌جا جبران می‌کند
Persistent=true
# فاصلهٔ حداقلی بین دو اجرا (محافظ در برابر restart loop)
AccuracySec=1min
Unit=printoo24-backup.service

[Install]
WantedBy=timers.target

